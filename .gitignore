# ==========================================
# 專案特定目錄管理
# ==========================================
# 忽略 /disk/ 目錄下的所有內容（通常用來放大型資料、暫存磁碟或掛載點）
/disk/*

# 例外規則：不要忽略 /disk/.gitkeep
# 這樣可以確保空的 /disk/ 目錄結構能被推送到 GitHub，但裡面的大檔案不會被上傳
!/disk/.gitkeep

# ==========================================
# 編譯產出、執行檔與二進位檔案 (Build Artifacts)
# ==========================================
*.o       # 忽略編譯產生的物件檔案 (Object files)
*.elf     # 忽略 Linux 可執行與連結格式檔案 (Executable and Linkable Format)
*.bin     # 忽略二進位檔案 (Binary files)
*.map     # 忽略編譯產生的記憶體對映檔或映射檔 (Map files)

# ==========================================
# 打包與壓縮檔案
# ==========================================
*.tar     # 忽略 tar 打包壓縮檔

# ==========================================
# 系統與執行日誌 / 紀錄檔
# ==========================================
*.log     # 忽略程式執行產生的日誌紀錄 (Log files)
*.pcap    # 忽略網路流量封包擷取檔 (Packet Capture files)
